{
  "name": "claude-multi-auth",
  "version": "0.1.0",
  "description": "Keep several Claude accounts logged in on one Mac and switch Claude Code and Claude Desktop between them. Installs the cma CLI and the menubar app.",
  "keywords": [
    "claude",
    "claude-code",
    "claude-desktop",
    "accounts",
    "cli",
    "macos",
    "menubar"
  ],
  "license": "MIT",
  "author": "huynhtuanhuy",
  "homepage": "https://github.com/huynhtuanhuy/claude-multi-auth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huynhtuanhuy/claude-multi-auth.git"
  },
  "bugs": {
    "url": "https://github.com/huynhtuanhuy/claude-multi-auth/issues"
  },
  "type": "module",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "cma": "bin/cma",
    "claude-multi-auth": "installer.mjs"
  },
  "files": [
    "bin/cma",
    "installer.mjs",
    "lib/installer.mjs",
    "checksums.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
